{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://backend-production-29e14.up.railway.app/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://backend-production-29e14.up.railway.app/sanctum/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
